# ─────────────────────────────────────────────────────────────
#  ARIA Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Groq API ──────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
# Help: Get your free API key from https://console.groq.com. Required for all LLM operations.

SYNTHESIS_GROQ_API_KEY=your_second_api_key_here
# Help: An optional separate API key used exclusively for the Tool Synthesis pipeline.

GROQ_MODEL=llama3-8b-8192
# Help: The specific Groq model ARIA will use for inference. Recommended: llama3-8b-8192 or llama3-70b-8192.


# ── Introspection Thresholds ───────────────────────────────────
SUCCESS_RATE_THRESHOLD=0.9
# Help: Float between 0.0 and 1.0. If a tool's success rate falls below this, the improvement loop triggers. (e.g., 0.9 = 90%)

LATENCY_THRESHOLD_SECONDS=5.0
# Help: Float. If a tool takes longer than this many seconds (p90 average), it will be flagged for speed optimization.

MIN_EXECUTIONS_FOR_ANALYSIS=10
# Help: Integer. The minimum number of times a tool must be used before ARIA is allowed to judge its performance and trigger improvements.


# ── Safety Limits ──────────────────────────────────────────────
MAX_IMPROVEMENT_CYCLES_PER_HOUR=5
# Help: Integer. The hard limit on how many times ARIA can rewrite code in one hour. Prevents runaway infinite loops.


# ── Scheduler ──────────────────────────────────────────────────
SCHEDULER_INTERVAL_MINUTES=30
# Help: Integer. How often the background scheduler wakes up to check the database for weak tools.


# ── Docker Sandbox ─────────────────────────────────────────────
SANDBOX_MEMORY_LIMIT=256m
# Help: String. The maximum amount of RAM the sandbox can use when testing new code. Keep this low (e.g., 256m) to prevent memory leak attacks.

SANDBOX_CPU_LIMIT=0.5
# Help: Float. The fraction of a single CPU core the sandbox is allowed to use. (e.g., 0.5 = half a core).

SANDBOX_TIMEOUT_SECONDS=30
# Help: Integer. Maximum time a test can run inside the sandbox before being forcefully killed and rejected.


# ── File Reader Tool ───────────────────────────────────────────
FILE_READER_ALLOWED_DIRS=./workspace,./data
# Help: Comma-separated list of directories. The AI is ONLY allowed to read files inside these folders. Prevents path traversal security risks.
SANDBOX_MEMORY_LIMIT=256m

# The Groq API rate limiter uses this to ensure we don't spam the API.
GROQ_MIN_REQUEST_INTERVAL_SECONDS=3.0

# ── Meta-Introspection & Clones ──
META_INTROSPECTION_INTERVAL=10
META_INTROSPECTION_MAX_HOURS=4.0
MAX_ROOTCAUSE_LLM_CALLS_PER_CYCLE=10
CLONE_BASE_DIR=/app/clones
CLONE_KEEP_ON_FAILURE=true
TEST_SIGNING_KEY=YOUR_16_CHAR_KEY
# Help: Float. The minimum time to wait between API calls to Groq. Prevents hitting HTTP 429 Too Many Requests errors.

GROQ_MAX_CALLS_PER_MINUTE=30
# Help: Integer. The absolute maximum number of API calls ARIA can make to Groq per minute.
