# ─────────────────────────────────────────────────────────────
#  ARIA Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Groq API ──────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# ── Introspection Thresholds ───────────────────────────────────
# Flag a tool as weak if rolling success rate drops below this
SUCCESS_RATE_THRESHOLD=0.70

# Flag a tool as weak if p90 latency (seconds) exceeds this
LATENCY_THRESHOLD_SECONDS=5.0

# Minimum number of executions before a tool can be flagged
MIN_EXECUTIONS_FOR_ANALYSIS=10

# ── Safety Limits ──────────────────────────────────────────────
# Maximum autonomous improvement cycles allowed per hour
MAX_IMPROVEMENT_CYCLES_PER_HOUR=5

# ── Scheduler ──────────────────────────────────────────────────
# How often (in minutes) the scheduler checks for weak tools
SCHEDULER_INTERVAL_MINUTES=30

# ── Docker Sandbox ─────────────────────────────────────────────
# Memory limit for sandboxed tool execution
SANDBOX_MEMORY_LIMIT=256m

# CPU limit (fraction of one core)
SANDBOX_CPU_LIMIT=0.5

# Timeout in seconds for sandbox execution
SANDBOX_TIMEOUT_SECONDS=30

# ── File Reader Tool ───────────────────────────────────────────
# Comma-separated list of directories the file reader tool may access
FILE_READER_ALLOWED_DIRS=./workspace,./data

# ── Groq Rate Limiting ─────────────────────────────────────────
# Minimum seconds between consecutive Groq API calls
GROQ_MIN_REQUEST_INTERVAL_SECONDS=3.0

# Maximum Groq calls per minute
GROQ_MAX_CALLS_PER_MINUTE=15
