# ARIA — Git Ignore

# Environment / secrets
.env

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
venv/
.venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs & databases
*.log
aria.db
*.db-shm
*.db-wal

# Docker
.docker/

# OS
.DS_Store
Thumbs.db

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Workspace data (user files, not ARIA source)
workspace/
data/

# ARIA output results 
Results/*
!Results/.gitkeep
